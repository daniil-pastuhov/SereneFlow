<?xml version="1.0" encoding="utf-8"?>
<!-- The Android-only text of the shared module: the running routine's notification, reminders, launcher
     shortcuts and Google Assistant's phrases. Android resources: apostrophes and quotes are escaped (\' and \"). -->
<resources>
    <string name="notification_channel_name">Running routine</string>
    <string name="notification_channel_description">Shows the current step and time left while a routine runs</string>
    <!-- The status bar chip while paused -->
    <string name="notification_paused">Paused</string>
    <string name="notification_action_resume">Resume</string>
    <string name="notification_action_pause">Pause</string>
    <string name="notification_action_skip">Skip</string>
    <string name="notification_action_end">End</string>
    <string name="notification_complete_title">Routine complete</string>
    <!-- %1$s: the routine's name -->
    <string name="notification_complete_text">You finished \"%1$s\". Take a moment to notice how you feel.</string>
    <string name="notification_ended">Routine ended</string>
    <string name="notification_step_position">Step %1$d of %2$d</string>
    <!-- %1$d: round; %2$d: rounds; %3$s: "Step 2 of 5" -->
    <string name="notification_round_step_position">Round %1$d of %2$d · %3$s</string>
    <!-- %1$s: time left, e.g. "01:30"; %2$s: "Step 2 of 5" -->
    <string name="notification_status_paused">Paused · %1$s left · %2$s</string>
    <!-- %1$s: "Step 2 of 5"; %2$s: the next step's name -->
    <string name="notification_status_next">%1$s · Up next: %2$s</string>
    <string name="notification_status_last">%1$s · Final step</string>

    <!-- A routine's daily reminder; its title is the routine's name. -->
    <string name="reminder_channel_name">Routine reminders</string>
    <string name="reminder_channel_description">Reminds you to start a routine at the time you set for it</string>
    <string name="reminder_notification_text">Time for your routine. Tap to begin.</string>

    <!-- A launcher shortcut's long label. %1$s: the routine's name -->
    <string name="shortcut_start_routine">Start %1$s</string>

    <!-- Google Assistant query patterns (custom App Actions intents, androidApp res/xml/shortcuts.xml):
         what follows "Hey Google, open SereneFlow and". Assistant matches them exactly; (word)?
         marks an optional word. Custom intents are en-US only. -->
    <string-array name="assistant_pause_queries">
        <item>pause</item>
        <item>pause (the)? routine</item>
        <item>pause (my)? routine</item>
        <item>pause (the)? timer</item>
    </string-array>
    <string-array name="assistant_resume_queries">
        <item>resume</item>
        <item>resume (the)? routine</item>
        <item>resume (my)? routine</item>
        <item>continue (the)? routine</item>
        <item>resume (the)? timer</item>
    </string-array>
    <string-array name="assistant_skip_queries">
        <item>skip (the)? step</item>
        <item>skip this step</item>
        <item>next step</item>
        <item>go to the next step</item>
        <item>skip to the next step</item>
    </string-array>
    <string-array name="assistant_end_queries">
        <item>stop</item>
        <item>end (the)? routine</item>
        <item>end (my)? routine</item>
        <item>stop (the)? routine</item>
        <item>finish (the)? routine</item>
        <item>stop (the)? timer</item>
    </string-array>
</resources>
