<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Keeps a running routine alive and visible while the app is in the background. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android 16 Live Updates (promoted ongoing notification / status-bar chip). -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <!-- Keeps the CPU awake while a routine is ticking so cues play on time with the screen off. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Haptic cues on step changes, the 3-2-1 countdown and completion (Settings > Vibration). -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Routine reminders at their exact minute (Alarms & reminders; inexact without it), and set
         again after a reboot, which clears alarms. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application>
        <service
            android:name="com.sereneflow.timer.session.TimerService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-started meditation routine timer with spoken step guidance" />
        </service>

        <receiver
            android:name="com.sereneflow.timer.session.TimerActionReceiver"
            android:exported="false" />

        <!-- A routine's daily reminder fires, or the alarms need setting again
             (platform/RoutineReminders.android.kt). The system's broadcasts reach it unexported. -->
        <receiver
            android:name="com.sereneflow.timer.platform.RoutineReminderReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Google Assistant's pause / resume / skip / end (androidApp res/xml/shortcuts.xml):
             no window and a task of its own, so the command doesn't bring the app forward.
             Exported for Assistant, which starts it by class; the filter lets
             `adb shell am start -a android.intent.action.VIEW -d sereneflow://skip` reach it. -->
        <activity
            android:name="com.sereneflow.timer.session.TimerControlActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="sereneflow" />
                <data android:host="pause" />
                <data android:host="resume" />
                <data android:host="skip" />
                <data android:host="end" />
            </intent-filter>
        </activity>

        <!-- Shares .sereneflow routine files (transfer/FileSharing.android.kt). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/shared_file_paths" />
        </provider>
    </application>
</manifest>
