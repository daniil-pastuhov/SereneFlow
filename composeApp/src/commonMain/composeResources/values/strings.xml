<?xml version="1.0" encoding="utf-8"?>
<!--
  Every user-visible string of the shared app, and everything screen readers or the voice say.
  Compose resources format only positional %1$s / %1$d arguments; a lone % is shown as is (no %%),
  and apostrophes and quotes need no escaping. A translation is a values-<language>/strings.xml
  with the same names.
-->
