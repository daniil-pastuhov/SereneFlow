<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="SereneFlow"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.SereneFlow">
        <!-- Started from the launcher through one of the aliases below. -->
        <activity
            android:name=".SereneFlowActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode|density|fontScale|locale|layoutDirection"
            android:windowSoftInputMode="adjustResize">
            <!-- sereneflow://start?routine=<id> starts a routine (launcher shortcuts, links). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="sereneflow" android:host="start" />
            </intent-filter>
            <!-- Opening a shared .sereneflow routine file (or a backup) offers to import it.
                 Providers rarely know the extension's type, so JSON and generic files are taken
                 too; the file's contents decide whether it is a routine. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:mimeType="application/json" />
                <data android:mimeType="application/vnd.sereneflow.routine+json" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.sereneflow" />
                <data android:pathPattern=".*\\..*\\.sereneflow" />
            </intent-filter>
        </activity>

        <!-- One launcher entry per app icon (it follows the theme); AppIconSwitcher enables one and
             disables the rest. Zen Sage is the default, and keeps the component name 1.0's launcher
             entry had (.MainActivity), so home-screen shortcuts from before survive the update.
             Names must match AppThemeMode.androidLauncherAlias (checked by AppIconAssetsTest). -->
        <activity-alias
            android:name=".MainActivity"
            android:targetActivity=".SereneFlowActivity"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherOceanMist"
            android:targetActivity=".SereneFlowActivity"
            android:icon="@mipmap/ic_launcher_ocean_mist"
            android:roundIcon="@mipmap/ic_launcher_ocean_mist_round"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherSunsetClay"
            android:targetActivity=".SereneFlowActivity"
            android:icon="@mipmap/ic_launcher_sunset_clay"
            android:roundIcon="@mipmap/ic_launcher_sunset_clay_round"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherMidnightStarlight"
            android:targetActivity=".SereneFlowActivity"
            android:icon="@mipmap/ic_launcher_midnight_starlight"
            android:roundIcon="@mipmap/ic_launcher_midnight_starlight_round"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>

</manifest>
