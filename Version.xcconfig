// The app version, shared by both platforms: Android's versionName (read by
// androidApp/build.gradle.kts) and iOS's MARKETING_VERSION (this file is the Xcode project's base
// configuration, so the app and the widget extension both inherit it). scripts/release bumps it;
// don't set MARKETING_VERSION anywhere else.
MARKETING_VERSION = 1.1.3
// scripts/ios_release.sh passes a timestamp for each upload; local builds use this one.
CURRENT_PROJECT_VERSION = 1

// The signing team (TEAM_ID, DEVELOPMENT_TEAM) is kept out of the repository: copy
// Secrets.xcconfig.example to Secrets.xcconfig next to this file. Optional, so simulator builds
// work without it; device builds and scripts/ios_release.sh need it. CI writes it from a secret.
#include? "Secrets.xcconfig"
